{
  "manifest_version": 3,
  "name": "YouTube Mobile App Simulator",
  "version": "1.1.0",
  "description": "Biến YouTube Web trên điện thoại (m.youtube.com) thành ứng dụng Native App: Vừa xem video mini-player vừa lướt trang chủ, phát nhạc nền khi ẩn tab/tắt màn hình, vuốt chạm mượt mà.",
  "author": "Kaziike/Antigravity AI",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YouTube Mobile App Simulator",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://youtube.com/*"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ],
      "css": [
        "styles/miniplayer.css"
      ],
      "js": [
        "scripts/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/injected.js",
        "styles/miniplayer.css"
      ],
      "matches": [
        "*://*.youtube.com/*",
        "*://youtube.com/*"
      ]
    }
  ]
}